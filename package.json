{
  "name": "ciq-developer-terminal",
  "productName": "CIQ Developer Terminal",
  "version": "0.3.0",
  "private": true,
  "description": "An independent AI developer terminal created by Stefano Roman Gunness, designed for CollectivIQ and powered by OpenCode.",
  "author": "Stefano Roman Gunness",
  "homepage": "https://github.com/stefanoromang/ciq-developer-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanoromang/ciq-developer-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/stefanoromang/ciq-developer-terminal/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "npm run build && electron tests/desktop-smoke.cjs",
    "test:native": "npm run build && electron tests/main-smoke.cjs",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:linux": "npm run build && electron-builder --linux tar.gz",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "install:user": "node scripts/install-user.mjs"
  },
  "dependencies": {
    "@opencode/cli": "2.2.6",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "ai.collectiviq.developer-terminal",
    "productName": "CIQ Developer Terminal",
    "asar": true,
    "asarUnpack": [
      "node_modules/@opencode/cli*/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "assets/icon.png",
      "assets/licenses/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ],
      "icon": "assets/icon.png",
      "artifactName": "CIQ-Developer-Terminal-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Development",
      "artifactName": "CIQ-Developer-Terminal-${version}-linux-${arch}.${ext}",
      "icon": "assets/icon.png",
      "executableName": "ciq-developer-terminal"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "CIQ-Developer-Terminal-${version}-windows-${arch}-portable.exe",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "CIQ-Developer-Terminal-${version}-windows-${arch}-setup.exe",
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
